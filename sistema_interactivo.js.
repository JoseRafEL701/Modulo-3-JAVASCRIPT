// Escuchamos el envío del formulario: capturamos, validamos y agregamos
// el producto, conectando todas las piezas anteriores.
formProducto.addEventListener("submit", (evento) => {
  evento.preventDefault();
 
  const nombre = inputNombre.value;
  const precio = inputPrecio.value;
  const descripcion = inputDescripcion.value;
 
  if (!validarCamposProducto(nombre, precio, descripcion)) {
    return; // la función ya mostró el mensaje de error correspondiente
  }
 
  agregarProducto(nombre, precio, descripcion);
  formProducto.reset(); // limpiamos el formulario para el siguiente registro
});
 
// Función de apoyo para las pruebas finales: imprime en consola un
// resumen del estado actual (arreglo, DOM y Local Storage) para poder
// comprobar y capturar que las tres fuentes coinciden entre sí.
