function mostrarMensaje(texto, tipo = "exito") {
  mensajeEl.textContent = texto;
  mensajeEl.className = tipo; // aplica la clase "exito" o "error" del CSS
 
  if (tipo === "error") {
    console.error(texto);
  } else {
    console.log(texto);
  }
 
  // El mensaje se limpia automáticamente después de unos segundos
  setTimeout(() => {
    mensajeEl.textContent = "";
    mensajeEl.className = "";
  }, 4000);
}
unction validarCamposProducto(nombre, precio, descripcion) {
  if (!nombre || nombre.trim() === "") {
    mostrarMensaje("Error: el nombre del producto no puede estar vacío.", "error");
    return false;
  }
 
  const precioNumerico = Number(precio);
  if (precio === "" || isNaN(precioNumerico) || precioNumerico <= 0) {
    mostrarMensaje("Error: ingresa un precio numérico mayor a 0.", "error");
    return false;
  }
 
  if (!descripcion || descripcion.trim() === "") {
    mostrarMensaje("Error: la descripción no puede estar vacía.", "error");
    return false;
  }
 
  return true;
}
 
