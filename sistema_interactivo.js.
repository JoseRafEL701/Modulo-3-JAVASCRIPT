function validarProducto(producto) {
  const tieneIdValido = Boolean(producto.id) && producto.id.trim() !== "";
  const tieneNombreValido =
    typeof producto.nombre === "string" && producto.nombre.trim() !== "";
  const tienePrecioValido =
    typeof producto.precio === "number" && producto.precio > 0;
 
  return tieneIdValido && tieneNombreValido && tienePrecioValido;
}
 
