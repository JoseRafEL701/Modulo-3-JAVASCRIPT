const URL_API = "http://localhost:3000/productos";
 
// GET: obtiene la lista completa de productos desde el servidor
async function obtenerProductosDesdeAPI() {
  try {
    const respuesta = await fetch(URL_API);
 
    if (!respuesta.ok) {
      throw new Error(`Error HTTP ${respuesta.status}`);
    }
 
    const datos = await respuesta.json();
    console.log("GET exitoso, productos recibidos:", datos);
    return datos;
  } catch (error) {
    console.error("Error al obtener productos de la API:", error);
    mostrarMensaje("No se pudo conectar con el servidor (GET).", "error");
    return null;
  }
}
 
// POST: agrega un nuevo producto en el servidor
async function crearProductoEnAPI(producto) {
  try {
    const respuesta = await fetch(URL_API, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(producto),
    });
 
    if (!respuesta.ok) {
      throw new Error(`Error HTTP ${respuesta.status}`);
    }
 
    const productoCreado = await respuesta.json();
    console.log("POST exitoso, producto creado en el servidor:", productoCreado);
 
    // Guardamos el id que asignó el servidor para futuras actualizaciones
    producto.apiId = productoCreado.id;
    guardarProductosEnLocalStorage();
 
    return productoCreado;
  } catch (error) {
    console.error("Error al crear producto en la API:", error);
    mostrarMensaje("El producto se guardó local pero no se sincronizó (POST).", "error");
    return null;
  }
}
 
// PUT: actualiza un producto existente en el servidor
async function actualizarProductoEnAPI(apiId, producto) {
  try {
    const respuesta = await fetch(`${URL_API}/${apiId}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(producto),
    });
 
    if (!respuesta.ok) {
      throw new Error(`Error HTTP ${respuesta.status}`);
    }
 
    const productoActualizado = await respuesta.json();
    console.log("PUT exitoso, producto actualizado en el servidor:", productoActualizado);
    return productoActualizado;
  } catch (error) {
    console.error("Error al actualizar producto en la API:", error);
    mostrarMensaje("No se pudo sincronizar la actualización (PUT).", "error");
    return null;
  }
}
 
// DELETE: elimina un producto del servidor
async function eliminarProductoEnAPI(apiId) {
  try {
    const respuesta = await fetch(`${URL_API}/${apiId}`, { method: "DELETE" });
 
    if (!respuesta.ok) {
      throw new Error(`Error HTTP ${respuesta.status}`);
    }
 
    console.log(`DELETE exitoso, producto ${apiId} eliminado del servidor.`);
  } catch (error) {
    console.error("Error al eliminar producto en la API:", error);
    mostrarMensaje("No se pudo eliminar el producto en el servidor (DELETE).", "error");
  }
}
 
// Botón "Sincronizar con API": trae los datos del servidor, los asigna
// como fuente de verdad local y refresca Local Storage + DOM.
btnSincronizar.addEventListener("click", async () => {
  estadoSincronizacionEl.textContent = "Sincronizando...";
  const productosDelServidor = await obtenerProductosDesdeAPI();
 
  if (productosDelServidor === null) {
    estadoSincronizacionEl.textContent = "Sincronización fallida. Revisa la consola.";
    return;
  }
 
  listaProductos = productosDelServidor.map((p) => ({
    id: p.id ? `api-${p.id}` : generarIdUnico(),
    nombre: p.nombre,
    precio: p.precio,
    descripcion: p.descripcion,
    apiId: p.id,
  }));
 
  guardarProductosEnLocalStorage();
  renderizarLista();
 
  estadoSincronizacionEl.textContent = `Sincronizado: ${listaProductos.length} producto(s) desde el servidor.`;
  mostrarMensaje("Sincronización con la API completada.", "exito");
});
 
