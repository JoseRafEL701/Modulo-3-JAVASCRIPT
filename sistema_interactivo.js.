// Crea el <li> de un producto, con su etiqueta, nombre, descripción,
// precio y los botones "Editar" y "Eliminar".
function crearElementoListaProducto(producto) {
  const li = document.createElement("li");
  li.className = "producto-item";
  li.dataset.id = producto.id; // guardamos el id en el propio elemento del DOM
 
  const tag = document.createElement("span");
  tag.className = "producto-tag";
  tag.textContent = `#${String(producto.id).slice(-4)}`;
 
  const info = document.createElement("div");
  info.className = "producto-info";
 
  const nombreEl = document.createElement("p");
  nombreEl.className = "producto-nombre";
  nombreEl.textContent = producto.nombre;
 
  const descripcionEl = document.createElement("p");
  descripcionEl.className = "producto-descripcion";
  descripcionEl.textContent = producto.descripcion;
 
  info.appendChild(nombreEl);
  info.appendChild(descripcionEl);
 
  const precioEl = document.createElement("span");
  precioEl.className = "producto-precio";
  precioEl.textContent = `$${Number(producto.precio).toLocaleString("es-CO")}`;
 
  const acciones = document.createElement("div");
  acciones.className = "producto-acciones";
 
  const btnEditar = document.createElement("button");
  btnEditar.className = "btn-icono editar";
  btnEditar.title = "Editar precio";
  btnEditar.textContent = "✎";
  btnEditar.addEventListener("click", () => editarPrecioProducto(producto.id));
 
  const btnEliminar = document.createElement("button");
  btnEliminar.className = "btn-icono eliminar";
  btnEliminar.title = "Eliminar producto";
  btnEliminar.textContent = "✕";
  // TASK 3: función para borrar el elemento al hacer clic
  btnEliminar.addEventListener("click", () => eliminarProducto(producto.id));
 
  acciones.appendChild(btnEditar);
  acciones.appendChild(btnEliminar);
 
  li.appendChild(tag);
  li.appendChild(info);
  li.appendChild(precioEl);
  li.appendChild(acciones);
 
  return li;
}
